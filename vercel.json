{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/restaurant-signup",
      "destination": "/reserve",
      "permanent": false
    },
    {
      "source": "/denver",
      "destination": "/wings/denver",
      "permanent": false
    },
    {
      "source": "/denver-passport",
      "destination": "/wings/denver",
      "permanent": false
    },
    {
      "source": "/denver-confirmation",
      "destination": "/wings/denver",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/desk",
      "destination": "/api/desk"
    },
    {
      "source": "/lineup",
      "destination": "/api/lineup"
    },
    {
      "source": "/lineup/:city",
      "destination": "/api/lineup?city=:city"
    },
    {
      "source": "/r/:token",
      "destination": "/api/r?t=:token"
    },
    {
      "source": "/book/:id",
      "destination": "/api/book?id=:id"
    },
    {
      "source": "/wings",
      "destination": "/api/shop?op=page&event=wings"
    },
    {
      "source": "/wings/:city",
      "destination": "/api/shop?op=page&event=wings&city=:city"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/shop?op=checkout"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/shop?op=webhook"
    },
    {
      "source": "/api/notify",
      "destination": "/api/shop?op=notify"
    },
    {
      "source": "/terms",
      "destination": "/api/shop?op=page&page=terms"
    }
  ],
  "functions": {
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/book.js": {
      "maxDuration": 30
    },
    "api/square-webhook.js": {
      "maxDuration": 30
    },
    "api/nightly.js": {
      "maxDuration": 30
    },
    "api/lineup.js": {
      "maxDuration": 10
    },
    "api/kickoff.js": {
      "maxDuration": 60
    },
    "api/support.js": {
      "maxDuration": 30
    },
    "api/desk.js": {
      "maxDuration": 60
    },
    "api/signup-notify.js": {
      "maxDuration": 10
    },
    "api/shop.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/nightly",
      "schedule": "0 2 * * *"
    }
  ]
}
