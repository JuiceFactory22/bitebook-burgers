{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/restaurant-signup",
      "destination": "/reserve",
      "permanent": false
    },
    {
      "source": "/denver-passport",
      "destination": "/wings/denver",
      "permanent": false
    },
    {
      "source": "/denver-confirmation",
      "destination": "/wings/denver",
      "permanent": false
    },
    {
      "source": "/reserve-page",
      "destination": "/reserve",
      "permanent": false
    },
    {
      "source": "/spin/:city(denver|nashville|phoenix)",
      "destination": "/spin/wings/:city",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/reserve",
      "destination": "/api/shop?op=reserve"
    },
    {
      "source": "/desk",
      "destination": "/api/desk"
    },
    {
      "source": "/lineup",
      "destination": "/api/lineup"
    },
    {
      "source": "/lineup/:city",
      "destination": "/api/lineup?city=:city"
    },
    {
      "source": "/r/:token",
      "destination": "/api/r?t=:token"
    },
    {
      "source": "/book/:id",
      "destination": "/api/book?id=:id"
    },
    {
      "source": "/wings",
      "destination": "/api/shop?op=page&event=wings"
    },
    {
      "source": "/wings/:city/purchased",
      "destination": "/api/shop?op=page&event=wings&city=thanks&from=:city"
    },
    {
      "source": "/wings/:city",
      "destination": "/api/shop?op=page&event=wings&city=:city"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/shop?op=checkout"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/shop?op=webhook"
    },
    {
      "source": "/api/notify",
      "destination": "/api/shop?op=notify"
    },
    {
      "source": "/terms",
      "destination": "/api/shop?op=page&page=terms"
    },
    {
      "source": "/spin",
      "destination": "/api/shop?op=spin"
    },
    {
      "source": "/spin/:event",
      "destination": "/api/shop?op=spin&event=:event"
    },
    {
      "source": "/spin/:event/:city/checkout",
      "destination": "/api/shop?op=page&event=:event&city=:city&via=spin"
    },
    {
      "source": "/spin/:event/:city/purchased",
      "destination": "/api/shop?op=page&event=:event&city=thanks&from=:city&via=spin"
    },
    {
      "source": "/spin/:event/:city/:stage(won|claimed)",
      "destination": "/api/shop?op=spin&event=:event&city=:city&stage=:stage"
    },
    {
      "source": "/spin/:event/:city",
      "destination": "/api/shop?op=spin&event=:event&city=:city"
    },
    {
      "source": "/api/spin",
      "destination": "/api/shop?op=spin"
    }
  ],
  "functions": {
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/book.js": {
      "maxDuration": 30
    },
    "api/square-webhook.js": {
      "maxDuration": 30
    },
    "api/nightly.js": {
      "maxDuration": 30
    },
    "api/lineup.js": {
      "maxDuration": 10
    },
    "api/kickoff.js": {
      "maxDuration": 60
    },
    "api/support.js": {
      "maxDuration": 30
    },
    "api/desk.js": {
      "maxDuration": 60
    },
    "api/signup-notify.js": {
      "maxDuration": 10
    },
    "api/shop.js": {
      "maxDuration": 30,
      "includeFiles": "reserve-page.html"
    }
  },
  "crons": [
    {
      "path": "/api/nightly",
      "schedule": "0 2 * * *"
    }
  ]
}
