{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/desk",
      "destination": "/api/desk"
    },
    {
      "source": "/lineup",
      "destination": "/api/lineup"
    },
    {
      "source": "/lineup/:city",
      "destination": "/api/lineup?city=:city"
    },
    {
      "source": "/r/:token",
      "destination": "/api/r?t=:token"
    },
    {
      "source": "/book/:id",
      "destination": "/api/book?id=:id"
    }
  ],
  "functions": {
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/book.js": {
      "maxDuration": 30
    },
    "api/square-webhook.js": {
      "maxDuration": 30
    },
    "api/nightly.js": {
      "maxDuration": 30
    },
    "api/lineup.js": {
      "maxDuration": 10
    },
    "api/kickoff.js": {
      "maxDuration": 60
    },
    "api/support.js": {
      "maxDuration": 30
    },
    "api/desk.js": {
      "maxDuration": 60
    },
    "api/signup-notify.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/nightly",
      "schedule": "0 2 * * *"
    }
  ]
}
